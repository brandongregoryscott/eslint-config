{
    "author": {
        "name": "Brandon Scott",
        "url": "https://github.com/brandongregoryscott"
    },
    "description": "ESLint config to be shared across projects",
    "devDependencies": {
        "@stylistic/eslint-plugin": "5.10.0",
        "@typescript-eslint/eslint-plugin": "8.72.1",
        "@typescript-eslint/parser": "8.72.1",
        "@vitest/eslint-plugin": "1.6.28",
        "eslint": "9.39.3",
        "eslint-plugin-collation": "1.8.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-package-json": "1.4.0",
        "eslint-plugin-perfectionist": "5.6.0",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "jsonc-eslint-parser": "3.3.0",
        "prettier": "3.8.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.0.5"
    },
    "keywords": [
        "lint",
        "code-style",
        "typescript",
        "eslint",
        "eslint-config",
        "react",
        "react-hooks",
        "hooks",
        "eslint-plugin",
        "eslintplugin"
    ],
    "license": "Apache-2.0",
    "name": "@brandongregoryscott/eslint-config",
    "repository": {
        "type": "git",
        "url": "https://github.com/brandongregoryscott/eslint-config.git"
    },
    "scripts": {
        "format": "prettier eslint.config.mjs spacing.mjs tests package.json --check",
        "format:fix": "prettier eslint.config.mjs spacing.mjs tests package.json --write",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "test": "vitest run"
    },
    "private": true,
    "version": "0.0.0-development",
    "type": "module"
}
